# Apenas no servidor. Nunca use prefixos públicos (VITE_/NEXT_PUBLIC_) para credenciais.
# Crie .env na raiz (ignorado pelo Git) ou configure no painel de hospedagem.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=35000
# Código privado distribuído aos professores; mínimo12 caracteres.
AI_ACCESS_PASSWORD=
# Segredo aleatório >=32 bytes. Rotacionar encerra todas as sessões.
# Gere: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
AI_SESSION_SECRET=
# Origem exata do frontend/API. HTTPS obrigatório para produção pública.
APP_ORIGIN=http://localhost:5173
# Tentativas autorizadas por dia, inclusive erros do provedor. Padrão500.
AI_DAILY_LIMIT=500
# Obrigatório na Vercel e com múltiplas réplicas. Redis REST compatível com Upstash.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
AI_REQUIRE_SHARED_LIMITS=false
# Ative apenas se seu proxy confiável substituir X-Forwarded-For.
AI_TRUST_PROXY=false
